&CONTROL
 calculation='scf',
 prefix='tin111',
 pseudo_dir='./pseudo/',
 outdir='./tmp/',
 verbosity='high',
/
&SYSTEM
 ibrav=0,
 nat=19,
 ntyp=2,
 ecutwfc=60.0,
 ecutrho=600.0,
 occupations='smearing',
 smearing='mv',
 degauss=0.01,
 input_dft='PBE',
 nbnd=120,
/
&ELECTRONS
 conv_thr=1.0d-10,
 electron_maxstep=300,
 mixing_mode='plain',
 mixing_beta=0.20,
 diagonalization='david',
/

